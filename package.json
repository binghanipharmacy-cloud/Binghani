{
  "name": "bin-ghani-pharmacy",
  "version": "1.0.0",
  "description": "Bin Ghani Pharmacy - Monorepo (Frontend + Backend)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "node dev-server.js",
    "security:audit": "node backend/tests/security-audit.js",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
