{
  "name": "bin-ghani-pharmacy",
  "version": "1.0.0",
  "description": "Bin Ghani Pharmacy - Monorepo (Frontend + Backend)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:export": "node -e \"process.env.NEXT_EXPORT='true'; require('child_process').execSync('npx next build', {stdio: 'inherit', env: {...process.env, NEXT_EXPORT: 'true'}})\"",
    "build:hostinger": "node build-hostinger.js",
    "deploy": "node deploy-gh-pages.js",
    "start": "next start",
    "start:server": "node server.js",
    "lint": "eslint",
    "build:frontend": "npm run build --workspace=frontend",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "security:audit": "node backend/tests/security-audit.js",
    "install:all": "npm install"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
